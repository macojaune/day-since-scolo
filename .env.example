# Développement local par défaut. Copier vers .env.local puis renseigner Clerk.
# Utiliser l'application Scolo du compte Clerk personnel, instance Development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

APP_URL="http://localhost:3092"
DATABASE_URL="file:./.local/scolo.db"
SCOLO_WALLET_MODE="local"
SCOLO_ENVIRONMENT="local"

# Synchronisation à la déclaration d'une apparition, après rapprochement du joueur.
# Credential dédié à cette application, jamais le token d'administration Zikak.
SCOLO_ZIKAK_SYNC_ENABLED="false"
ZIKAK_API_ORIGIN="https://api-zikak-dev.marvinl.com"
ZIKAK_APPLICATION_ID="scolo-dev-local"
ZIKAK_INTEGRATION_TOKEN=""

# DEV hébergé : SCOLO_ENVIRONMENT=dev, SCOLO_WALLET_MODE=local,
# APP_URL=https://scolo-dev.marvinl.com, DATABASE_URL=file:/data/scolo-dev.db,
# clés Clerk Development et source ZIKAK_APPLICATION_ID=scolo-dev dédiée.
# Pour le service public, utiliser un jeu de variables séparé :
# SCOLO_ENVIRONMENT=prod, SCOLO_WALLET_MODE=scolo, APP_URL=https://scolo.marvinl.com,
# DATABASE_URL=libsql://<base>.turso.io et les clés Clerk pk_live_ / sk_live_.
# Sa future liaison utilise scolo-prod vers Zikak DEV, avec son propre credential.
# L'activation et la promotion PROD restent des opérations distinctes.
DATABASE_AUTH_TOKEN=""

# Publication X séparée de la connexion Clerk. Désactivée tant que non validée.
SCOLO_TWEETS_ENABLED="false"
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# Identifiants Clerk autorisés à déclarer une apparition, séparés par des virgules.
# Vide = aucun administrateur. Aucun privilège accordé depuis le navigateur.
SCOLO_ADMIN_USER_IDS=""
