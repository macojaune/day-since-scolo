# Développement local par défaut. Copier vers .env.local puis renseigner Clerk.
# Utiliser l'application Scolo du compte Clerk personnel, instance Development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

APP_URL="http://localhost:3092"
DATABASE_URL="file:./.local/scolo.db"
SCOLO_WALLET_MODE="local"

# Pour la préparation du service public, utiliser un jeu de variables séparé :
# SCOLO_WALLET_MODE=scolo, APP_URL=https://scolo.marvinl.com,
# DATABASE_URL=libsql://<base>.turso.io et les clés Clerk pk_live_ / sk_live_.
# Les Zikak du mode scolo sont persistants, propres à ce jeu, sans liaison globale.
DATABASE_AUTH_TOKEN=""

# Publication X séparée de la connexion Clerk. Désactivée tant que non validée.
SCOLO_TWEETS_ENABLED="false"
# Buffer Free : Settings > API, puis identifiant du canal X connecté.
# Aucun appel à l’API X payante. Publication réelle réservée à PROD.
BUFFER_API_KEY=""
BUFFER_CHANNEL_ID=""

# Identifiants Clerk autorisés à déclarer une apparition, séparés par des virgules.
# Vide = aucun administrateur. Aucun privilège accordé depuis le navigateur.
SCOLO_ADMIN_USER_IDS=""
