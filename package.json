{
  "name": "day-since-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:local": "node --env-file=.env.local --import tsx scripts/local-db.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed-local.ts",
    "dev": "next dev --turbopack --hostname localhost -p 3092",
    "lint": "eslint src scripts tests --max-warnings 0 --no-error-on-unmatched-pattern",
    "start": "next start --hostname localhost -p 3092",
    "with-env": "dotenv -e ./.env.local --",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/localizations": "4.24.3",
    "@clerk/nextjs": "7.9.22",
    "@daypicker/react": "10.0.2",
    "@libsql/client": "^0.14.0",
    "@t3-oss/env-nextjs": "^0.10.1",
    "@tanstack/react-query": "5.105.0",
    "@trpc/client": "11.19.0",
    "@trpc/next": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "drizzle-orm": "^0.37.0",
    "geist": "^1.3.0",
    "next": "15.5.28",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "superjson": "^2.2.1",
    "zod": "^3.23.3"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.52",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.10.1",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.29.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.28",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.16",
    "tsx": "4.23.15",
    "typescript": "^5.7.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.36.2"
  },
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.9.0"
  }
}
